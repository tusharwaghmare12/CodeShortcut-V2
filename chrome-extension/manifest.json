{
  "manifest_version": 3,
  "name": "CodeShortcut",
  "version": "1.0.0",
  "description": "Browser-based coding snippet & autocomplete extension for competitive programmers and students.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CodeShortcut Settings & Snippets",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "data/defaultSnippets.js",
        "utils/snippetParser.js",
        "utils/storage.js",
        "utils/editorAdapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
